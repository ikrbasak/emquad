{
  "name": "emquad",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fmt": "oxfmt . && cargo fmt --all",
    "fmt:check": "oxfmt --check . && cargo fmt --all -- --check",
    "lint": "oxlint --deny-warnings && cargo clippy --all-targets --all-features -- -D warnings",
    "test": "cargo test",
    "bench": "cargo bench",
    "licenses": "cargo deny check licenses && cargo about generate --output-file THIRD-PARTY-NOTICES.md about.hbs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.17.0"
}
