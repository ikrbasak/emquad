{
  "name": "emquad",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "fmt": "oxfmt . && cargo fmt --all",
    "fmt:check": "oxfmt --check . && cargo fmt --all -- --check",
    "lint": "oxlint --deny-warnings && cargo clippy --all-targets --all-features -- -D warnings",
    "test": "cargo test && turbo run test",
    "test:node": "turbo run test",
    "bench": "cargo bench",
    "prepare": "lefthook install",
    "notices": "cargo deny check licenses && cargo about generate --output-file THIRD-PARTY-NOTICES.md about.hbs",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm --filter @emquad/typst-binding exec napi version && pnpm install --no-frozen-lockfile",
    "changeset:status": "changeset status --since=origin/main"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0"
}
