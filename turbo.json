{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // `*.node` and the generated loader belong to @emquad/binding, whose
      // build is a several-minute LTO link. Declaring them as outputs is what
      // lets turbo skip it on every run after the first.
      "outputs": ["dist/**", "*.node", "index.js", "index.d.ts"]
    },
    // No dependencies. Nothing here type-checks against another package's
    // build output: @emquad/binding's declarations are generated by napi-rs and
    // committed, and the other packages' `include` globs cover `src` only.
    // Keeping `^build` off this task is what lets CI type-check without first
    // paying for a multi-minute LTO link.
    "typecheck": {},
    "test": {
      // `^build` as well as `build`: the core suite runs against the native
      // addon from @emquad/binding, and the resolver's integration tests run
      // against @emquad/core's `dist`.
      "dependsOn": ["build", "^build"],
      // Tests read fixtures and write diff artifacts that turbo does not
      // track. Caching a run that depends on untracked files would report a
      // stale pass, which is the one failure mode a test cache must not have.
      "cache": false
    },

    // @emquad/binding's own test script rebuilds the addon with the
    // `test-hooks` feature, overwriting the `.node` file that every other
    // package's tests have already loaded. Run concurrently — which is turbo's
    // default, since neither declares a dependency on the other — that is a
    // race: a suite starting mid-rebuild loads a truncated binary.
    //
    // Ordering them is the fix. The coupling is real rather than incidental:
    // these tasks share one mutable artifact.
    "@emquad/core#test": {
      "dependsOn": ["build", "^build", "@emquad/binding#test"],
      "cache": false
    },
    "@emquad/resolver#test": {
      "dependsOn": ["build", "^build", "@emquad/binding#test"],
      "cache": false
    },

    "clean": {
      "cache": false
    }
  }
}
