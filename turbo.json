{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    // No `^build`. Nothing here needs another package's build output in order
    // to build: tsdown externalizes @emquad/typst-binding, and the declarations it
    // type-checks against are generated by napi-rs and committed. Wiring the
    // dependency anyway would drag @emquad/typst-binding's several-minute LTO link
    // into every task that transitively touches it — which, before this, was
    // most of them.
    "build": {
      "outputs": ["dist/**", "*.node", "index.js", "index.d.ts"]
    },

    // Likewise builds nothing. Every tsconfig's `include` covers `src` only.
    "typecheck": {},

    "test": {
      "dependsOn": ["build"],
      // Tests read fixtures and write diff artifacts that turbo does not
      // track. Caching a run that depends on untracked files would report a
      // stale pass, which is the one failure mode a test cache must not have.
      "cache": false
    },

    // @emquad/typst-binding's test script builds its own addon, with the
    // `test-hooks` feature that release builds deliberately lack. It needs
    // nothing from the graph — and crucially it must NOT depend on
    // `build`, which is the release LTO link whose output it would then
    // immediately overwrite.
    "@emquad/typst-binding#test": {
      "cache": false
    },

    // The suites that load the addon wait for the build above rather than
    // racing it: run concurrently, a suite starting mid-rebuild loads a
    // truncated binary. Depending on `@emquad/typst-binding#test` rather than
    // `^build` is also what keeps the release build out of the test path.
    "@emquad/core#test": {
      "dependsOn": ["build", "@emquad/fonts#build", "@emquad/typst-binding#test"],
      "cache": false
    },
    "@emquad/resolver#test": {
      "dependsOn": [
        "build",
        "@emquad/core#build",
        "@emquad/fonts#build",
        "@emquad/typst-binding#test"
      ],
      "cache": false
    },

    "clean": {
      "cache": false
    }
  }
}
