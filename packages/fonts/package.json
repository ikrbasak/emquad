{
  "name": "@emquad/fonts",
  "version": "0.0.1",
  "description": "The default Typst font set for @emquad/core, shipped byte-for-byte.",
  "keywords": [
    "dejavu",
    "fonts",
    "libertinus",
    "new-computer-modern",
    "otf",
    "pdf",
    "pdf-generation",
    "typeface",
    "typst"
  ],
  "homepage": "https://github.com/ikrbasak/emquad#readme",
  "bugs": "https://github.com/ikrbasak/emquad/issues",
  "license": "OFL-1.1 AND LPPL-1.3c AND GPL-3.0-or-later AND Bitstream-Vera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikrbasak/emquad.git",
    "directory": "packages/fonts"
  },
  "files": [
    "dist",
    "fonts",
    "licenses",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "clean": "rm -rf dist",
    "sync": "node scripts/sync.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
