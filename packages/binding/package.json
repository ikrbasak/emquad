{
  "name": "@emquad/typst-binding",
  "version": "0.0.1",
  "description": "Native bindings for @emquad/core. Not useful on its own.",
  "keywords": [
    "bindings",
    "napi",
    "napi-rs",
    "native",
    "pdf",
    "pdf-generation",
    "typst"
  ],
  "homepage": "https://github.com/ikrbasak/emquad#readme",
  "bugs": "https://github.com/ikrbasak/emquad/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikrbasak/emquad.git",
    "directory": "packages/binding"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "napi build --manifest-path ../../crates/emquad-napi/Cargo.toml --package-json-path ./package.json --platform --esm --output-dir . --release",
    "build:debug": "napi build --manifest-path ../../crates/emquad-napi/Cargo.toml --package-json-path ./package.json --platform --esm --output-dir .",
    "build:test": "napi build --manifest-path ../../crates/emquad-napi/Cargo.toml --package-json-path ./package.json --platform --esm --output-dir . --features test-hooks",
    "test": "npm run build:test && node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.0"
  },
  "optionalDependencies": {
    "@emquad/typst-binding-darwin-arm64": "0.0.1",
    "@emquad/typst-binding-darwin-x64": "0.0.1",
    "@emquad/typst-binding-linux-arm64-gnu": "0.0.1",
    "@emquad/typst-binding-linux-arm64-musl": "0.0.1",
    "@emquad/typst-binding-linux-x64-gnu": "0.0.1",
    "@emquad/typst-binding-linux-x64-musl": "0.0.1",
    "@emquad/typst-binding-win32-arm64-msvc": "0.0.1",
    "@emquad/typst-binding-win32-x64-msvc": "0.0.1"
  },
  "napi": {
    "binaryName": "emquad",
    "packageName": "@emquad/typst-binding",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
