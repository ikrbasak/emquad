{
  "name": "@emquad/resolver",
  "version": "0.0.1",
  "description": "@preview package resolution for @emquad/core. Owns all networking.",
  "keywords": [
    "pdf",
    "pdf-generation",
    "preview",
    "registry",
    "resolver",
    "typst",
    "typst-packages"
  ],
  "homepage": "https://github.com/ikrbasak/emquad#readme",
  "bugs": "https://github.com/ikrbasak/emquad/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikrbasak/emquad.git",
    "directory": "packages/resolver"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "clean": "rm -rf dist",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@emquad/core": "workspace:*",
    "@emquad/fonts": "workspace:*",
    "@types/node": "^26.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
