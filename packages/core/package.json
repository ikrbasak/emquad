{
  "name": "@emquad/core",
  "version": "0.0.2",
  "description": "Typst PDF generation for Node. VFS in, PDF out.",
  "keywords": [
    "document-generation",
    "invoice",
    "napi-rs",
    "pdf",
    "pdf-generation",
    "pdf-generator",
    "puppeteer-alternative",
    "report",
    "typst"
  ],
  "homepage": "https://github.com/ikrbasak/emquad#readme",
  "bugs": "https://github.com/ikrbasak/emquad/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikrbasak/emquad.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "clean": "rm -rf dist",
    "test": "tsc -p test/types && node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@emquad/typst-binding": "workspace:*"
  },
  "devDependencies": {
    "@emquad/fonts": "workspace:*",
    "@types/node": "^26.1.2",
    "mupdf": "^1.28.0"
  },
  "engines": {
    "node": ">=22"
  }
}
